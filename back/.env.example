# Copy this file to ".env" and fill in real values.
# Loaded by spring.config.import=optional:file:.env[.properties]

# MySQL credentials
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT: >= 32 chars. Rotate for production.
JWT_SECRET=change-me-min-32-characters-random-string
JWT_EXPIRATION_MS=86400000

# Show SQL in logs (dev only)
SHOW_SQL=false
